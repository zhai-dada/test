find_path(LIB60870_INCLUDE_DIR
	NAMES cs104_connection.h
	HINTS "${LIB60870_ROOT}/include/lib60870"
)

find_library(LIB60870_LIBRARY
	NAMES lib60870
	HINTS "${LIB60870_ROOT}/lib"
)

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(Lib60870
	REQUIRED_VARS LIB60870_INCLUDE_DIR LIB60870_LIBRARY
)

if(Lib60870_FOUND AND NOT TARGET Lib60870::Lib60870)
	add_library(Lib60870::Lib60870 STATIC IMPORTED)
	set_target_properties(Lib60870::Lib60870 PROPERTIES
		IMPORTED_LOCATION "${LIB60870_LIBRARY}"
		INTERFACE_INCLUDE_DIRECTORIES "${LIB60870_INCLUDE_DIR}"
		INTERFACE_LINK_LIBRARIES "pthread;m;rt"
	)
endif()

mark_as_advanced(LIB60870_INCLUDE_DIR LIB60870_LIBRARY)
